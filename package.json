{
  "name": "ssh-process-analyzer",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node collector-api/src/index.js",
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:emulator": "firebase --project demo-ssh-analyzer --config firebase/firebase.json emulators:exec --only firestore \"node --test tests/emulator/*.test.js\"",
    "test:all": "npm test && npm run test:emulator"
  },
  "devDependencies": {
    "firebase-tools": "^13.35.1",
    "wrangler": "^4.97.0"
  },
  "dependencies": {
    "firebase-admin": "^14.2.0"
  }
}
