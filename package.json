{
  "name": "ssh-process-analyzer",
  "version": "0.8.2",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node collector-api/src/index.js",
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:emulator": "firebase --project demo-ssh-analyzer emulators:exec --only firestore \"node --test tests/emulator/*.test.js\"",
    "test:all": "npm test && npm run test:emulator",
    "build:web": "npm --prefix web install --silent && npm --prefix web run build",
    "verify:web": "node web/scripts/verify-artifact.mjs",
    "deploy:web": "npm run build:web && npm run verify:web && firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.18.0",
    "firebase-tools": "^13.35.1",
    "wrangler": "^4.97.0"
  },
  "dependencies": {
    "firebase-admin": "^14.2.0"
  }
}
