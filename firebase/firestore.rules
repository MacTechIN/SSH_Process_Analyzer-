rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isTenantMember(tenantId) {
      return signedIn()
        && exists(/databases/$(database)/documents/tenants/$(tenantId)/memberships/$(request.auth.uid));
    }

    function isPublishedGeneration(tenantId, hostId, generationId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)/hosts/$(hostId)).data.publishedGeneration
        == generationId;
    }

    match /tenants/{tenantId} {
      allow read: if isTenantMember(tenantId);
      allow write: if false;

      // A signed in user may always read their own membership document, even when it does
      // not exist. Gating this on isTenantMember() is circular: the helper checks for the
      // very document being read, so a non member gets permission-denied instead of an
      // empty result and the app cannot tell the two apart.
      match /memberships/{uid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }

      match /hosts/{hostId} {
        allow read: if isTenantMember(tenantId);
        allow write: if false;

        // History is exposed only through the authenticated server API.
        match /snapshots/{snapshotId} {
          allow read, write: if false;
        }

        match /generations/{generationId} {
          allow read: if isTenantMember(tenantId)
            && isPublishedGeneration(tenantId, hostId, generationId);
          allow write: if false;

          match /processes/{processKey} {
            allow read: if isTenantMember(tenantId)
              && isPublishedGeneration(tenantId, hostId, generationId);
            allow write: if false;
          }
        }
      }

      match /agents/{agentId} {
        allow read, write: if false;
      }
    }

    match /replayRecords/{recordId} {
      allow read, write: if false;
    }
  }
}
