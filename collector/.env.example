API_BASE_URL=
AGENT_ID=
AGENT_KEY_ID=
AGENT_PRIVATE_KEY_PATH=/var/lib/ssh-process-collector/agent-key.pem
STATE_DIR=/var/lib/ssh-process-collector
COLLECT_INTERVAL_SECONDS=60
GZIP_ENABLED=true
INCLUDE_KERNEL_THREADS=false
REQUEST_TIMEOUT_SECONDS=20
PUSH_MAX_ATTEMPTS=3
PUSH_BASE_BACKOFF_MS=500
PUSH_MAX_BACKOFF_MS=8000
LOCK_STALE_SECONDS=900
CLOCK_TICKS_PER_SECOND=100
PAGE_SIZE_BYTES=4096
SPOOL_ENABLED=true
SPOOL_MAX_BYTES=104857600
SPOOL_MAX_FILES=1000
SPOOL_MAX_FILE_BYTES=8388608
SPOOL_RETENTION_SECONDS=86400
SPOOL_MAX_RESEND_PER_RUN=10
